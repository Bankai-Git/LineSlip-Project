MAX_IMAGE_BYTES=10485760
HOST=127.0.0.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen3.5:9b
LOCAL_AI_TIMEOUT_MS=60000
SUMMARY_CRON=0 21 * * *
SUMMARY_TIMEZONE=Asia/Bangkok
DASHBOARD_LINE_USER_ID=replace-with-your-line-user-id
DASHBOARD_USERNAME=replace-with-a-username
DASHBOARD_PASSWORD=replace-with-a-long-local-password
